{
  "compilerOptions": {
    "target": "es2016",
    "jsx": "react",
    "module": "ES6",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": "build"
  },
  "include": ["Global.d.ts", "src/**/*"],
  "exclude": ["build", "dist", "node_modules"]
}
